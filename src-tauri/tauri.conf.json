{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Shot Card",
  "version": "0.6.8",
  "identifier": "com.akaanbayazit.igkamerabilgisablonu",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "The Shot Card",
        "width": 1480,
        "height": 980,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
